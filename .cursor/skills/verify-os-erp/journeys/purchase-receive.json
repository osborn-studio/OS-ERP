  {"click": "审批", "role": "button", "exact": true, "within": "tbody tr:first-child"},
  {"waitGone": "审批", "role": "button", "exact": true, "within": "tbody tr:first-child"},
  {"shot": "approved"},
  {"click": "收货", "role": "button", "exact": true, "within": "tbody tr:first-child"},
  {"waitText": "确认收货入库", "role": "button"},
  {"sleep": 500},
  {"shot": "receive-modal"},
  {"click": "确认收货入库", "role": "button"},
