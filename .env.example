# 复制为 .env 后填写；.env 已被 .gitignore / .dockerignore 排除，不要提交、不要打进镜像。
# docker compose 会自动读取同目录 .env 做变量插值，并经 env_file 注入容器。

# 必填：JWT 签名密钥。生成：openssl rand -hex 32
# 留空或使用公开已知值（如 README 里的演示值）时，生产模式启动即拒绝。
GML_JWT_SECRET=

# 可选：构建 SHA，写入 /api、/api/meta/health、AI manifest、MCP serverInfo 的 build_sha。
# 例：GML_BUILD_SHA=$(git rev-parse HEAD) docker compose build
GML_BUILD_SHA=
